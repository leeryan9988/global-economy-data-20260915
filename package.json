{
  "name": "global-economy-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "snapshot:series": "tsx scripts/generate-series-snapshot.ts",
    "snapshot:homepage": "tsx scripts/generate-homepage-snapshot.ts",
    "snapshot:refresh": "pnpm snapshot:series && pnpm snapshot:homepage",
    "test:db": "tsx scripts/verify-database.ts",
    "sync:world-bank": "tsx scripts/sync-world-bank.ts",
    "readiness": "tsx scripts/check-production-readiness.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
